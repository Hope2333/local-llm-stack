    },
    "bonsai-27b-long": {
      "backend": "llama",
      "kind": "text",
      "path": "~/models/bonsai2/27B/Ternary-Bonsai-2-27B-PTQ1_0.gguf",
      "ctx": 131072,
      "device": "Vulkan1",
      "n_gpu_layers": 99,
      "threads": 12,
      "params": "26.9B",
      "quant": "PTQ1_0",
      "cache_type": "q4_0",
