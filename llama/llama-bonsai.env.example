# llama.cpp / Bonsai-2 服务配置模板
# 复制到 ~/.config/llama-bonsai.env 后修改，然后：
#   systemctl --user restart llama-bonsai
#
# 路径支持 ~ 和 ${HOME}（llama-bonsai-run 会展开）。
# systemd 的 EnvironmentFile 本身不做变量展开，所以不要在这里用 $VAR 引用别的变量。

# ---- 模型 ----
BONSAI_MODEL=~/models/bonsai2/9B/Ternary-Bonsai-2-9B-PQ2_0.gguf

# 视觉投影器，可选。纯文本任务留空可省 848 MiB 显存
BONSAI_MMPROJ=~/models/bonsai2/9B/Ternary-Bonsai-2-9B-mmproj-Q8_0.gguf

# ---- 后端 ----
# Vulkan0 = AMD Radeon 610M（32GB GTT）   Vulkan1 = RTX 4060 Laptop（8GB）
# 实测 9B PQ2_0：CPU 11.5 t/s  >  610M 6.6 t/s  >>  4060 49.6 t/s
# 留空 = 纯 CPU：KV 和大模型都吃系统内存，不受 8GB 限制
BONSAI_DEVICE=
BONSAI_NGL=0

# ---- CPU 线程 ----
# 实测 t=12 最优（pp 362 / tg 11.5）；超过 16 线程双 CCD 抢带宽，崩到 1.5-5 t/s
BONSAI_THREADS=12

# ---- 上下文 ----
# 9B 实测：32768/65536/131072/262144 全部可用且解码速度不变（12.1-12.4 t/s）
BONSAI_CTX=32768

# ---- KV 缓存量化（长上下文建议 q4_0，2 倍压缩）----
# BONSAI_CACHE_TYPE=q4_0

# ---- 卸载（-ot，把指定层的 FFN 下沉到 CPU）----
# 27B 到 128K 上下文的用法见 docs/offload-tuning.md
# BONSAI_OVERRIDE='blk\.(4[0-9]|5[0-9]|6[0-3])\.ffn_.*=CPU'

# ---- MTP 投机解码 ----
# 只在 CPU 档开：9B 12.4 -> 23.0 t/s（1.85x），4B 27.0 -> 41.2 t/s
# GPU 档是负收益（4B 78.6 -> 54.4，9B 48.3 -> 39.5），务必留空
# n-max 实测 4 最优（2 -> 18.8 / 3 -> 22.8 / 4 -> 23.6 / 6 -> 19.7）
BONSAI_MTP_MODEL=~/models/bonsai2/9B/Ternary-Bonsai-2-9B-PQ2_0-MTP-Q8_0.gguf
BONSAI_MTP_N_MAX=2

# ---- 27B GPU 档（全量进 8GB）----
# 实测 PTQ1_0（5.53 GiB）可全量：pp128 170.7 / tg64 26.7 t/s，显存约 7.4 GiB
# 与 OXR（约 3GB）争显存，只能二选一；切换时先停 OXR 再改下面三行：
#   BONSAI_MODEL=~/models/bonsai2/27B/Ternary-Bonsai-2-27B-PTQ1_0.gguf
#   BONSAI_DEVICE=Vulkan1
#   BONSAI_NGL=99
# 注意：PQ2_0（6.70 GiB）全量会 OOM，只能 ngl≈28 部分卸载（tg 6.83，不划算）

# ---- 服务 ----
BONSAI_HOST=127.0.0.1
BONSAI_PORT=8081
BONSAI_ALIAS=bonsai
