# llama.cpp / Bonsai 2 server configuration
# 改完执行: systemctl --user restart llama-bonsai

# ---- 模型 ----
BONSAI_MODEL=/home/miao/models/bonsai2/9B/Ternary-Bonsai-2-9B-PQ2_0.gguf
BONSAI_MMPROJ=/home/miao/models/bonsai2/9B/Ternary-Bonsai-2-9B-mmproj-Q8_0.gguf

# ---- 后端（实测 9B PQ2_0：CPU 11.5 t/s > 610M 6.6 t/s；4060 49.6 t/s）----
# Vulkan0 = AMD Radeon 610M (32GB GTT)   Vulkan1 = RTX 4060 Laptop (8GB)
# 留空 = 纯 CPU (Ryzen 9 7945HX)，KV cache 与大模型都吃系统内存，无 8GB 限制
BONSAI_DEVICE=
BONSAI_NGL=0

# ---- CPU 线程（实测 t=12 最优：pp 362 / tg 11.5；超 16 线程反而崩到 1.5-5 t/s）----
BONSAI_THREADS=12

# ---- 上下文（27B FP16 KV ≈ 64KiB/token，32768 ≈ 2GB）----
BONSAI_CTX=32768

# ---- MTP 投机解码（官方推荐）。实测 9B/CPU：解码 10.33 -> 14.11 t/s (1.37x)，
#      代价是 prefill 63 -> 14.6 t/s。长上下文 RAG 场景建议清空此项关掉。----
BONSAI_MTP_MODEL=/home/miao/models/bonsai2/9B/Ternary-Bonsai-2-9B-PQ2_0-MTP-Q8_0.gguf
BONSAI_MTP_N_MAX=2

# ---- 27B GPU 档（实测：PTQ1_0 5.53GiB 可全量进 8GB，pp128 170.7 / tg64 26.7 t/s）
# 与 OXR(2.6GB)、layout(0.5GB) 争显存，只能二选一；切换时先停 OXR 再改下面三行：
#   BONSAI_MODEL=/home/miao/models/bonsai2/27B/Ternary-Bonsai-2-27B-PTQ1_0.gguf
#   BONSAI_DEVICE=Vulkan1
#   BONSAI_NGL=99
# PQ2_0(6.70GiB) 全量会 OOM，只能 ngl≈28 部分卸载（tg 6.83，不划算）。

# ---- 服务 ----
BONSAI_HOST=127.0.0.1
BONSAI_PORT=8081
