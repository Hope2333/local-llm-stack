#!/usr/bin/env bash
# Compose llama-server args from ~/.config/llama-bonsai.env
set -euo pipefail

: "${BONSAI_MODEL:?BONSAI_MODEL not set}"
: "${BONSAI_MMPROJ:?BONSAI_MMPROJ not set}"

args=(
  --model "$BONSAI_MODEL"
  --mmproj "$BONSAI_MMPROJ"
  --ctx-size "${BONSAI_CTX:-32768}"
  --flash-attn on
  --jinja
  --reasoning "${BONSAI_REASONING:-off}"
  --host "${BONSAI_HOST:-127.0.0.1}"
  --port "${BONSAI_PORT:-8081}"
  --alias bonsai-2
  --threads "${BONSAI_THREADS:-12}"
  --temp 0.7 --top-p 0.80 --min-p 0 --presence-penalty 1.0
  --repeat-penalty 1.0 --repeat-last-n 64
)

if [ -n "${BONSAI_DEVICE:-}" ]; then
  args+=(--device "$BONSAI_DEVICE" --n-gpu-layers "${BONSAI_NGL:-99}")
else
  args+=(--n-gpu-layers 0 --device none)
fi

if [ -n "${BONSAI_MTP_MODEL:-}" ]; then
  args+=(
    --model-draft "$BONSAI_MTP_MODEL"
    --spec-type draft-mtp
    --spec-draft-n-max "${BONSAI_MTP_N_MAX:-2}"
    --spec-draft-n-min 0
    --spec-draft-p-min 0
  )
fi

exec "$HOME/opt/llama-prism/bin/llama-server" "${args[@]}"
